# Supabase / Neon Postgres connection strings
# DATABASE_URL is for PgBouncer (pooled connections), DIRECT_URL is for migrations
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Amazon Associates tag (required)
AMAZON_ASSOCIATE_TAG="your-tag-here"

# Not used yet in Phase 1 — added here for Phase 2
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# GROQ_API_KEY=""
